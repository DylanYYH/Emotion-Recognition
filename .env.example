# Copy this file to .env and fill in ONE key. Never commit .env.

# Layer 2 with Claude Sonnet 5 (https://console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ...or with an OpenAI model (https://platform.openai.com, billed separately from ChatGPT Plus)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# auto = use Anthropic if its key is set, otherwise OpenAI, otherwise the local analysis
LLM_PROVIDER=auto

# Change this before deploying anywhere public
FLASK_SECRET_KEY=dev-secret-key-change-in-production
